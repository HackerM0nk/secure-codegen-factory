{
  "name": "secure-codegen",
  "version": "2.0.0",
  "private": true,
  "description": "Security-first AI code generation platform with 16 defense-in-depth layers wrapping untrusted LLMs in sandboxed workspaces",
  "author": "hackerm0nk",
  "keywords": ["ai", "code-generation", "security", "llm", "defense-in-depth", "sandbox", "docker", "kubernetes"],
  "repository": { "type": "git", "url": "https://github.com/hackerm0nk/secure-codegen" },
  "scripts": {
    "dev": "concurrently \"npx tsx watch src/server/index.ts\" \"next dev -p 3100\"",
    "dev:server": "npx tsx watch src/server/index.ts",
    "dev:next": "next dev -p 3100",
    "build": "next build",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "test": "npx jest",
    "test:security": "npx jest tests/security/",
    "test:coverage": "npx jest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:security": "npx playwright test e2e/tests/security.spec.ts e2e/tests/security-scanning.spec.ts",
    "test:e2e:k8s": "WORKSPACE_RUNTIME=kubernetes npx playwright test e2e/tests/k8s-security.spec.ts",
    "test:security:regression": "npx tsx tests/e2e-security/harness.ts --report",
    "test:security:regression:verbose": "npx tsx tests/e2e-security/harness.ts --report --verbose",
    "test:security:e2e": "npx tsx tests/e2e-security/harness.ts --mode=e2e --report",
    "test:security:model-regression": "npx tsx tests/e2e-security/model-regression.ts",
    "test:security:pipeline": "npx tsx tests/e2e-security/full-pipeline-test.ts",
    "test:security:pipeline:report": "npx tsx tests/e2e-security/full-pipeline-test.ts --report",
    "k8s:setup": "bash k8s/setup.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "latest",
    "@anthropic-ai/sdk": "latest",
    "@aws-sdk/client-s3": "^3.600.0",
    "@kubernetes/client-node": "^0.21.0",
    "@monaco-editor/react": "^4.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@prisma/client": "^5.19.0",
    "@swc/core": "^1.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "next": "15.0.0",
    "openai": "^4.60.0",
    "pino": "^9.4.0",
    "prom-client": "^15.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-resizable-panels": "^2.1.0",
    "tar-stream": "^3.1.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "jest": "^30.3.0",
    "postcss": "^8.4.47",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
