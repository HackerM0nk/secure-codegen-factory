# =============================================================================
# secure-codegen-factory — Environment Configuration
# Copy to .env: cp .env.example .env
# =============================================================================

# --- LLM Providers ---
# At least one provider is required. Ollama is free and local.
# For best results, use Anthropic or AWS Bedrock with Claude Sonnet.

# Option A: Ollama (free, local — install from https://ollama.com)
# Run: ollama pull qwen2.5-coder:7b
DEFAULT_LLM_PROVIDER=ollama
LLM_PROVIDERS=ollama

# Option B: Anthropic (recommended for quality)
# DEFAULT_LLM_PROVIDER=anthropic
# LLM_PROVIDERS=anthropic,ollama
ANTHROPIC_API_KEY=

# Option C: AWS Bedrock
# DEFAULT_LLM_PROVIDER=bedrock
# LLM_PROVIDERS=bedrock,ollama
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Option D: OpenAI
# DEFAULT_LLM_PROVIDER=openai
# LLM_PROVIDERS=openai,ollama
OPENAI_API_KEY=

# --- Model Routing ---
# Models are selected by task complexity. Use the best model you have access to.
# Ollama defaults (good free option):
SIMPLE_MODEL=qwen2.5-coder:7b
MEDIUM_MODEL=qwen2.5-coder:7b
COMPLEX_MODEL=qwen2.5-coder:7b
# Claude defaults (best quality — uncomment if using Anthropic/Bedrock):
# SIMPLE_MODEL=claude-haiku-4-5-20251001
# MEDIUM_MODEL=claude-sonnet-4-20250514
# COMPLEX_MODEL=claude-sonnet-4-20250514

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Uncensored Model (for security testing) ---
# dolphin-mistral:7b complies with all requests — used to stress-test security.
# Run: ollama pull dolphin-mistral:7b
UNCENSORED_MODEL=dolphin-mistral:7b

# --- Behavioral Detection ---
BEHAVIORAL_DETECTION_ENABLED=true

# --- Database ---
DATABASE_URL=postgresql://devfactory:devfactory@localhost:5534/devfactory

# --- Redis ---
REDIS_URL=redis://localhost:6480

# --- S3 (LocalStack) ---
S3_ENDPOINT=http://localhost:4666
S3_BUCKET=workspace-snapshots
S3_REGION=us-east-1

# --- Auth (Keycloak) ---
KEYCLOAK_URL=http://localhost:8280
KEYCLOAK_REALM=devfactory
KEYCLOAK_CLIENT_ID=devfactory-api
KEYCLOAK_CLIENT_SECRET=dev-secret
JWT_SECRET=dev-jwt-secret-change-in-production

# --- Observability ---
JAEGER_OTLP_ENDPOINT=http://localhost:4418
LOG_LEVEL=info
NODE_ENV=development

# --- Stripe (mock) ---
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_API_URL=http://localhost:12211

# --- App ---
PORT=4100
FRONTEND_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100
WORKSPACE_RUNTIME=docker
WORKSPACE_IMAGE=devfactory-workspace:latest

# --- Alerting ---
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# --- Kubernetes (when WORKSPACE_RUNTIME=kubernetes) ---
K8S_NAMESPACE=agent-workloads
K8S_WORKSPACE_IMAGE=devfactory-workspace:latest
